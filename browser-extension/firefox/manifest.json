{
  "manifest_version": 3,
  "name": "DLSS5 Video Controls",
  "version": "2.0.5",
  "description": "Tune DLSS5 neural rendering on streaming video and send the playing video to the DLSS5 player.",
  "permissions": [
    "nativeMessaging",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_title": "DLSS5 Video Controls"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "panel.css"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "24d3d842-83df-5342-9b6f-dcfd0efb52ba",
      "strict_min_version": "115.0"
    }
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+D"
      },
      "description": "Show DLSS5 controls"
    }
  }
}
